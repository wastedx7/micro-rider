# Supabase PostgreSQL connection used by ride-service and user-service.
# Use the pooler connection string for application traffic when appropriate.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-supabase-database-password

# JWT signing configuration. Use a strong base64-encoded key in real environments.
SECRET_KEY=replace-with-base64-encoded-secret-key
JWT_ISSUER=micro-rider-user-service
JWT_EXPIRATION_MS=3600000

# Local infrastructure defaults.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional local gateway service overrides.
USER_SERVICE_URI=http://localhost:8085
RIDE_SERVICE_URI=http://localhost:8081
LOCATION_SERVICE_URI=http://localhost:8082
ASSIGNMENT_SERVICE_URI=http://localhost:8083
NOTIFICATION_SERVICE_URI=http://localhost:8084
